# Help: Debug options for the tools/debugvm QEMU debug VM
#
# Merged on top of x86_64_defconfig and kernel/configs/kvm_guest.config by
# tools/debugvm/build-kernel.sh.  The goal is a kernel gdb can make full sense
# of: complete DWARF, the in-tree gdb helper scripts, frame pointers, and a
# fixed load address so symbols resolve for a gdb that attached before boot.

CONFIG_DEBUG_KERNEL=y

# Full (unreduced, unsplit, uncompressed) debug info, plus the links that make
# scripts/gdb/vmlinux-gdb.py load automatically next to vmlinux.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
# CONFIG_DEBUG_INFO_COMPRESSED_ZLIB is not set
CONFIG_GDB_SCRIPTS=y

# KASLR relocates the kernel image, which breaks symbol resolution for a gdb
# that attached at reset.  run-vm.sh also passes nokaslr; turning the feature
# off in the config as well means no surprises.
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RANDOMIZE_MEMORY is not set

# Readable backtraces.  gdb does not understand the ORC unwinder's custom
# format, so use the frame pointer unwinder: slightly slower kernel, correct
# backtraces in gdb.
# CONFIG_UNWINDER_ORC is not set
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_FRAME_POINTER=y
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_STACKTRACE=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# BTF needs pahole and slows the build down; DWARF is what gdb reads here.
# CONFIG_DEBUG_INFO_BTF is not set

# Useful from inside the guest.
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_KPROBES=y

# kgdb on the second serial port, for when you want to break into a running
# guest rather than attach to QEMU's stub at reset.
CONFIG_KGDB=y
CONFIG_KGDB_SERIAL_CONSOLE=y
CONFIG_KGDB_KDB=y

# Catch the classic bugs.  These cost runtime, which is the point of a debug VM.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_SLUB_DEBUG=y

# Root on virtio-blk with ext4, built in, so no initramfs is required.
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Entropy, so userspace does not stall early in boot.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

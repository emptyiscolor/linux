# Help: Optional KASAN fragment for the tools/debugvm QEMU debug VM
#
# Enabled by tools/debugvm/build-kernel.sh --kasan.  Generic KASAN roughly
# doubles kernel memory use and slows the guest down noticeably, so it is off by
# default; give the VM more RAM (run-vm.sh --memory 4G or more) when using it.

CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_KASAN_VMALLOC=y
CONFIG_KASAN_STACK=y
CONFIG_STACKTRACE=y
CONFIG_SLUB_DEBUG=y

# The KUnit KASAN test suite, as a module: `modprobe kasan_test` in the guest
# deliberately triggers out-of-bounds and use-after-free accesses, so you can
# confirm KASAN is really catching things before you go looking for a real bug.
CONFIG_KUNIT=m
CONFIG_KASAN_KUNIT_TEST=m
